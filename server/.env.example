# ── Base de datos ─────────────────────────────────────────────
# Local con docker compose:  postgres://rumbo:rumbo@localhost:5432/rumbo_seguro
DATABASE_URL=postgres://rumbo:rumbo@localhost:5432/rumbo_seguro
# true en Railway/Render si la conexión exige SSL
DATABASE_SSL=false

# ── Seguridad ─────────────────────────────────────────────────
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_EXPIRES_IN=7d

# ── Servidor ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Origen(es) del frontend, separados por coma
CLIENT_URL=http://localhost:5173
# true en producción para que este servidor entregue también el frontend compilado
SERVE_CLIENT=false
# Aplica migraciones pendientes al arrancar
MIGRATE_ON_START=true

# ── Archivos subidos ──────────────────────────────────────────
# En Railway monta un Volume y apunta aquí (ej. /data/uploads)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ── Seed (npm run seed) ───────────────────────────────────────
ADMIN_EMAIL=admin@rumboseguro.co
ADMIN_PASSWORD=cambia-esta-clave-admin
# true solo en desarrollo: crea agencias y viajero de demostración
SEED_DEMO=true

# ── Pruebas (npm test) — ¡esta base se BORRA en cada corrida! ─
TEST_DATABASE_URL=postgres://rumbo:rumbo@localhost:5432/rumbo_test
